PORT=3000
NODE_ENV=development
# Set true only when the API is behind a trusted reverse proxy that sets client IP headers.
TRUST_PROXY=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=carlift_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET=replace-this-development-secret
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PASSWORD_RESET_ACCESS_TOKEN=replace-with-a-32-character-or-longer-random-secret
